# Gemini API Key (Server-Side Agent Engine)
GEMINI_API_KEY=

# OpenRouter API Key (Optional alternative LLM Provider)
OPENROUTER_API_KEY=

# Live Email Delivery (Optional Resend or SMTP settings)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Nyx autonomy worker
NYX_APP_URL=http://127.0.0.1:3000
NYX_AUTONOMY_POLL_MS=60000
NYX_AUTONOMY_COOLDOWN_MS=21600000
NYX_AUTONOMY_MAX_OBJECTIVES_PER_DAY=4
NYX_AUTONOMY_STATE_FILE=.nyx/autonomy-state.json
NYX_AUTONOMY_FOCUS=digital nomads and local hospitality businesses in Palawan, Philippines
NYX_AUTONOMY_LOCATION=Palawan, Philippines
NYX_AUTONOMY_INDUSTRIES=resorts, boutique hotels, hostels, tour operators, restaurants, cafes, dive shops, coworking spaces, property managers, transport businesses

# Optional self-hosted discovery provider
NYX_SEARXNG_URL=

# Web research limits
NYX_SCRAPE_TIMEOUT_MS=12000
NYX_SCRAPE_MAX_BYTES=1500000
NYX_SCRAPE_USER_AGENT=NyxResearchBot/1.0 (+public-business-research)
NYX_CRAWL_MAX_PAGES=8
NYX_CRAWL_DELAY_MS=1200
