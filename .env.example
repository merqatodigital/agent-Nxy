# Existing Nyx model configuration
OPENROUTER_API_KEY=

# Existing Nyx app
NYX_APP_URL=http://127.0.0.1:3000

# Always-on worker
NYX_WORKER_PORT=3001
NYX_WORKER_TICK_MS=60000
NYX_RESEARCH_INTERVAL_MINUTES=60
NYX_RESEARCH_CONCURRENCY=2
NYX_WORKER_STATE_FILE=.nyx/worker-state.json
NYX_SCRAPE_TIMEOUT_MS=12000
NYX_SCRAPE_MAX_BYTES=1500000
NYX_SCRAPE_USER_AGENT=NyxSDRResearchBot/1.0

# Email transport (standard SMTP, independent of the LLM provider)
# Leave blank to keep sending disabled while draft/approval jobs still work.
NYX_SMTP_HOST=
NYX_SMTP_PORT=587
NYX_SMTP_SECURE=false
NYX_SMTP_STARTTLS=true
NYX_SMTP_USERNAME=
NYX_SMTP_PASSWORD=
NYX_SMTP_FROM=
NYX_SMTP_HELO=nyx.local
